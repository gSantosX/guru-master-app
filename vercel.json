{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/gemini/:path*", "destination": "/api/gemini?path=:path*" },
    { "source": "/api/auth/send-code", "destination": "/api/auth?action=send-code" },
    { "source": "/api/auth/verify-code", "destination": "/api/auth?action=verify-code" },
    { "source": "/api/auth/forgot-password", "destination": "/api/auth?action=forgot-password" },
    { "source": "/api/auth/reset-password", "destination": "/api/auth?action=reset-password" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  }
}

